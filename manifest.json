{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "version": "0.1.1",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "__MSG_extName__"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "alarms",
    "scripting",
    "cookies",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://www.douyin.com/*",
    "https://www.youtube.com/*",
    "https://x.com/*",
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://getmarksync.pages.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "content/xhs.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "content/dyHook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "content/douyin.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
